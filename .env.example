NODE_ENV=development
PORT=3000
# Direct/local traffic: do not trust forwarded IP headers.
# For one reverse proxy, set hops=1 and list only that proxy's source IP/CIDR.
TRUST_PROXY_HOPS=0
TRUST_PROXY_CIDRS=
# Production: comma-separated exact HTTPS browser origins. Empty permits native,
# server-to-server, and webhook requests without Origin but no browser origins.
CORS_ALLOWED_ORIGINS=
# Per-request deadline for Alchemy RPC/pricing, Zerion, and CoinGecko fallback.
PROVIDER_REQUEST_TIMEOUT_MS=5000
# Maximum pages fetched for one wallet/chain (100 items requested per page).
ZERION_MAX_PAGES=10
ALCHEMY_TOKEN_BALANCE_MAX_PAGES=5
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wallet_tracker
# Local development defaults to no TLS. Production defaults to verified TLS.
# For production, use DATABASE_SSL_MODE=verify-full and optionally a trusted CA file,
# or put sslmode=verify-full (and optionally sslrootcert) in DATABASE_URL instead.
# Do not mix TLS settings in DATABASE_URL with the variables below.
# DATABASE_SSL_MODE=verify-full
# DATABASE_SSL_CA_FILE=/path/to/provider-ca.pem
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_MIGRATION_LOCK_WAIT_TIMEOUT_MS=10000
DATABASE_MIGRATION_LOCK_TIMEOUT_MS=5000
DATABASE_MIGRATION_STATEMENT_TIMEOUT_MS=300000
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
# Optional. Enables GET /api/v1/operations/status when set (minimum 32 chars).
OPERATIONS_DIAGNOSTICS_TOKEN=
JWT_ACCESS_TOKEN_TTL_SECONDS=604800
LOG_LEVEL=info
ENABLE_PUSH_NOTIFICATIONS=false
# Webhook-first mode: keep false in normal real-time operation.
# Set true only for local polling tests or fallback/debug runs.
ENABLE_ETHEREUM_TRACKER=false
ENABLE_PORTFOLIO_SNAPSHOT_JOB=true
PORTFOLIO_SNAPSHOT_INTERVAL_MS=3600000
FIREBASE_DRY_RUN=true
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_ANDROID_NOTIFICATION_CHANNEL_ID=fcm_fallback_notification_channel
# Production requires the Notify API key, distinct Ethereum/Base webhook IDs,
# and each webhook's own signing secret from Alchemy.
ALCHEMY_NOTIFY_API_KEY=
ALCHEMY_NOTIFY_REQUEST_TIMEOUT_MS=10000
ALCHEMY_ADDRESS_ACTIVITY_WEBHOOK_ID_ETHEREUM_MAINNET=
ALCHEMY_ADDRESS_ACTIVITY_WEBHOOK_ID_BASE_MAINNET=
ALCHEMY_WEBHOOK_SIGNING_SECRET_ETHEREUM_MAINNET=
ALCHEMY_WEBHOOK_SIGNING_SECRET_BASE_MAINNET=
# Local unsigned webhook testing only; production rejects this setting.
ALCHEMY_WEBHOOK_ALLOW_UNSIGNED_DEV=false
ALCHEMY_ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key
ALCHEMY_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your-key
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key
DEBANK_ACCESS_KEY=
ZERION_API_KEY=
ETHEREUM_CONFIRMATIONS=6
ETHEREUM_BATCH_SIZE=250
ETHEREUM_POLL_INTERVAL_MS=15000
ETHEREUM_START_BLOCK=0
ETHEREUM_RPC_REQUEST_DELAY_MS=1000
ETHEREUM_RPC_MAX_RETRIES=5
ETHEREUM_RPC_BACKOFF_BASE_MS=1000
ETHEREUM_RESET_SYNC_CURSOR=false
ETHEREUM_TRACE_FROM_ADDRESS=
ETHEREUM_TRACE_TO_ADDRESS=
ETHEREUM_TRACE_TX_HASH=
